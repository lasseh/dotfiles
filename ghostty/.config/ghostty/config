# Fonts
font-family = "Hack Nerd Font"
font-size = 18
font-thicken = true
adjust-cell-height = 2
bold-is-bright = false
theme = TokyoNight

# Cursor Configuration
cursor-color = #c0caf5
cursor-style = block
cursor-style-blink = false
cursor-opacity = 0.8

# Selection Colors
selection-background = #283457
selection-foreground = #c0caf5

# Window Configuration
window-height = 50
window-width = 200
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
unfocused-split-opacity = 0.7
unfocused-split-fill = #1a1b26
# Default: auto-determined based on background (darkens bg by 0.08 if dark theme, 0.4 if light)
split-divider-color = #8b008b
#background-opacity = 0.95
#background-blur-radius = 20


# Mouse and Interaction
mouse-hide-while-typing = true
# tmux (`set -g mouse on`) grabs mouse events, and ghostty skips link
# detection entirely while a program holds the mouse — plain cmd+click can
# never open a link there. Shift is the only bypass; `never` makes that
# bypass unconditional (a program can't re-grab it via XTSHIFTESCAPE), so
# cmd+shift+click opens links inside tmux. Outside tmux, cmd+click works.
mouse-shift-capture = never
copy-on-select = true
link-url = true

# Shell Integration
shell-integration = detect
# ssh-env: remotes get TERM=xterm-256color + COLORTERM=truecolor. Replaces
# the old global `term = xterm-256color` override, which broke local keyboard
# handling (Claude Code shift+enter, kitty keyboard protocol).
# ssh-terminfo is deliberately off: it opens a probe connection to every
# uncached host to run `tic`, which doubles the wait on unreachable hosts
# (ConnectTimeout x ConnectionAttempts, twice) and prints a warning on every
# ssh to hosts without tic (Junos, appliances) since failures are not cached.
# no-title: ghostty's title hook runs after our precmd() (tokyo-night-
# theme.zsh) and clobbers the custom "user@host: repo/path" title that
# iTerm2 shows — let the zsh theme own the window title instead.
shell-integration-features = no-title,ssh-env

# macOS Specific Settings
# Match iTerm2: left option = Esc+ (word nav, meta keys), right option
# stays normal for typing special characters ([ ] { } @ \ etc.)
macos-option-as-alt = left
macos-titlebar-style = tabs
window-theme = dark
window-decoration = true
quit-after-last-window-closed = true
window-save-state = always

# Key Bindings (Common iTerm2 equivalents)
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+left=goto_split:previous
keybind = cmd+shift+right=goto_split:next
keybind = cmd+left=previous_tab
keybind = cmd+right=next_tab
keybind = cmd+k=clear_screen
# iTerm2 parity: cmd+enter = fullscreen, cmd+shift+enter = maximize pane
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+s=open_config
# Shift+Enter = newline in Claude Code (same as iTerm2 /terminal-setup)
keybind = shift+enter=text:\n
# Font size presets: dock (external monitor) vs laptop screen
keybind = ctrl+cmd+1=set_font_size:16
keybind = ctrl+cmd+2=set_font_size:24

# Terminal Behavior
window-inherit-working-directory = true
confirm-close-surface = false
# Bytes; iTerm2 was set to unlimited scrollback, 100MB is close enough
scrollback-limit = 100000000
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# Bell: 1.3.1 regression — the 🔔 tab indicator doesn't appear on unfocused
# tabs until clicked and doesn't clear cleanly (ghostty discussion #10692).
# Disable it until a fixed release ships; `attention` (dock-icon bounce when
# Ghostty is unfocused) still works and remains enabled by default.
bell-features = no-title

auto-update = check

